{
    "ajax": {
        "prefix": "aj",
        "body": [
            "$.ajax({",
            "    'url': '${TM_FILENAME_BASE}_q.php',",
            "    'method': 'POST',",
            "    'data': {",
            "        'request': '$1',",
            "        'a_session': getFormData('form_session_generale')",
            "    }",
            "}).done(function(data) {",
            "    console.log(data);",
            "    $2",
            "}).fail(function(response) {",
            "    return_fail(response);",
            "})"
        ],
        "description": "Ajax normale"
    },
    "ajax personalizzato": {
        "prefix": "ajp",
        "body": [
            "$.ajax({",
            "    'url': 'include_pers.php?file_pers_include=${TM_FILENAME_BASE}_q.php&',",
            "    'method': 'POST',",
            "    'data': {",
            "        'request': '$1',",
            "        'a_session': getFormData('form_session_generale')",
            "    }",
            "}).done(function(data) {",
            "    console.log(data);",
            "    $2",
            "}).fail(function(response) {",
            "    return_fail(response);",
            "})"
        ],
        "description": "Ajax con include_pers per request personalizzate"
    },
    "selector id": {
        "prefix": "$#",
        "body": ["$('#$1')"],
        "description": "jQuery selector con id"
    },
    "selector class": {
        "prefix": "$.",
        "body": ["$('.$1')"],
        "description": "jQuery selector con class"
    },
    "jquery val": {
        "prefix": "val",
        "body": [".val($1)"],
        "description": "jQuery .val()"
    },
    "jquery click": {
        "prefix": "click",
        "body": [
            ".click(function()",
            "{",
            "    $1",
            "});"
        ],
        "description": "jQuery .click()"
    },
    "jquery on": {
        "prefix": "on",
        "body": [
            ".on('$1',function()",
            "{",
            "    $2",
            "});"
        ],
        "description": "jQuery .on(event)"
    },
    "jquery on selector": {
        "prefix": "ons",
        "body": [
            ".on('$1','$2',function()",
            "{",
            "    $3",
            "});"
        ],
        "description": "jQuery .on(event, selector)"
    },
    "Definizione funzione": {
        "prefix": "func",
        "body": [
            "function ${1:myFunction}(${2:args})",
            "{",
            "    $3",
            "}"
        ],
        "description": "Definizione di funzione"
    },
    "Inizializzazione JS": {
        "prefix": "initjs",
        "body": [
            "$(document).ready(function()",
            "{",
            "    $1",
            "});"
        ],
        "description": "Document ready jQuery"
    }
}
