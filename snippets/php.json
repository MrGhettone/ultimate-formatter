{
    "Definizione funzione": {
        "prefix": "func",
        "body": [
            "function ${1:myFunction}(${2:args})",
            "{",
            "    $3",
            "}"
        ],
        "description": "Definizione di funzione"
    },
    "definizione for": {
        "prefix": "for",
        "body": [
            "for(${1:\\$i} = 0; ${1:\\$i} < count(${2:\\$array}); ${1:\\$i}++)",
            "{",
            "    $3",
            "}"
        ],
        "description": "Ciclo for PHP"
    },
    "definizione foreach": {
        "prefix": "foreach",
        "body": [
            "if(is_array(${1:\\$array}))",
            "{",
            "    foreach($1 as ${2:\\$akey} => ${3:\\$value})",
            "    {",
            "        $4",
            "    }",
            "}"
        ],
        "description": "Foreach con controllo is_array"
    },
    "query select": {
        "prefix": "querys",
        "body": [
            "\\$query = \"SELECT * \";",
            "\\$query.= \"FROM ${1:nome_tabella} \";",
            "\\$query.= \"WHERE ${2:param} = '${3:value}' \";",
            "\\$query.= \"AND ${4:param2} = '${5:value}' \";",
            "",
            "\\$ris = DB_query(\\$conn,\\$DB,\\$query,\\$tipoServer);",
            "\\$rec = DB_fetch(\\$ris,\\$tipoServer);"
        ],
        "description": "Query SELECT con DB_query e DB_fetch"
    },
    "print_r": {
        "prefix": "print_r",
        "body": ["print '<pre>'.print_r(${1:\\$var},true).'</pre>';"],
        "description": "Print_r formattato in HTML"
    },
    "Inizializzazione file q": {
        "prefix": "initq",
        "body": [
            "<?php",
            "header('Content-Type: application/json; charset=utf-8');",
            "include('func.php');",
            "include('../integr/func_integr.php');",
            "\\$conn = DB_connect(\\$server,\\$login,\\$array_pwd_profili[\\$login],\\$DB,\\$tipoServer);",
            "\\$return_array = array();",
            "",
            "switch(\\$_REQUEST['request'])",
            "{",
            "    case '$1':",
            "    {",
            "        $2",
            "    }",
            "}",
            "",
            "if(\\$attivita_rep == 'si')",
            "{",
            "    logger_attivita(\\$_REQUEST['request'],\\$query_log);",
            "}",
            "",
            "if(\\$conn)",
            "    DB_close(\\$conn,\\$tipoServer);",
            "",
            "echo json_encode(\\$return_array);",
            "?>"
        ],
        "description": "Inizializzazione file _q.php per backend"
    },
    "Inizializzazione front": {
        "prefix": "initf",
        "body": [
            "<?php include('head_pag.php'); ?>",
            "<script src=\"<?php echo include_pers('${TM_FILENAME_BASE}.js'); ?>\" type=\"text/javascript\"></script>",
            "$1",
            "<?php include('foot_pag.php'); ?>"
        ],
        "description": "Inizializzazione pagina frontend"
    }
}
